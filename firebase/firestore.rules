rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid}/weights/{id} {
      allow read, delete: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.keys().hasAll(['kg', 'recordedAt'])
        && request.resource.data.keys().hasOnly(['kg', 'recordedAt'])
        && request.resource.data.kg is number
        && request.resource.data.kg > 0 && request.resource.data.kg <= 1000
        && request.resource.data.recordedAt == request.time;
    }
    match /users/{uid}/eternalNotes/{id} {
      function validEternal() {
        return request.resource.data.keys().hasAll(['body', 'days', 'createdAt', 'dismissedOn'])
          && request.resource.data.keys().hasOnly(['body', 'days', 'createdAt', 'dismissedOn'])
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 10000
          && request.resource.data.days is list
          && request.resource.data.days.size() >= 1 && request.resource.data.days.size() <= 7
          && request.resource.data.days.hasOnly([0, 1, 2, 3, 4, 5, 6])
          && request.resource.data.days.toSet().size() == request.resource.data.days.size()
          && request.resource.data.createdAt is int
          && request.resource.data.dismissedOn is string
          && (request.resource.data.dismissedOn == '' || request.resource.data.dismissedOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
      }
      allow read, delete: if owns(uid);
      allow create: if owns(uid) && validEternal()
        && id.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$')
        && request.resource.data.createdAt >= request.time.toMillis() - 120000
        && request.resource.data.createdAt <= request.time.toMillis() + 120000;
      allow update: if owns(uid) && validEternal()
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    match /users/{uid}/temponotes/{id} {
      allow read, delete: if owns(uid);
      allow create: if owns(uid)
        && id.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$')
        && request.resource.data.keys().hasAll(['body', 'createdAt', 'expiresAt'])
        && request.resource.data.keys().hasOnly(['body', 'createdAt', 'expiresAt'])
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 10000
        && request.resource.data.createdAt is int
        && request.resource.data.expiresAt is int
        && request.resource.data.createdAt >= request.time.toMillis() - 120000
        && request.resource.data.createdAt <= request.time.toMillis() + 120000
        && request.resource.data.expiresAt - request.resource.data.createdAt >= 3600000
        && request.resource.data.expiresAt - request.resource.data.createdAt <= 31536000000
        && (request.resource.data.expiresAt - request.resource.data.createdAt) % 1800000 == 0
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.expiresAt <= request.time.toMillis() + 31536000000;
      allow update: if owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt'])
        && request.resource.data.expiresAt is int
        && resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.expiresAt - resource.data.expiresAt in [1800000, 3600000, 21600000]
        && request.resource.data.expiresAt <= request.time.toMillis() + 31536000000;
    }
    match /users/{uid}/temponotesMeta/clock {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['serverNow'])
        && request.resource.data.serverNow == request.time;
    }
    // Each signed-in person can access only their own saved progress.
    match /users/{uid}/progress/{key} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['value', 'updatedAt', 'version', 'revision'])
        && request.resource.data.version == 1
        && request.resource.data.revision is int
        && ((!exists(/databases/$(database)/documents/users/$(uid)/progress/$(key))
             && request.resource.data.revision == 1)
          || (exists(/databases/$(database)/documents/users/$(uid)/progress/$(key))
             && request.resource.data.revision == resource.data.revision + 1))
        && request.resource.data.value is string
        && request.resource.data.value.size() <= 700000
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}

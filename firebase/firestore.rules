rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in person can access only their own saved progress.
    match /users/{uid}/progress/{key} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['value', 'updatedAt', 'version', 'revision'])
        && request.resource.data.version == 1
        && request.resource.data.revision is int
        && ((!exists(/databases/$(database)/documents/users/$(uid)/progress/$(key))
             && request.resource.data.revision == 1)
          || (exists(/databases/$(database)/documents/users/$(uid)/progress/$(key))
             && request.resource.data.revision == resource.data.revision + 1))
        && request.resource.data.value is string
        && request.resource.data.value.size() <= 700000
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
